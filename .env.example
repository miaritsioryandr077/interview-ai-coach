# ---------------------------------------------------------------------------
# InterviewAI Coach — variables pour Docker Compose
# Copier ce fichier en .env à la racine :  cp .env.example .env
# Le fichier .env ne doit JAMAIS être committé.
# ---------------------------------------------------------------------------

# --- PostgreSQL (service "db") ---------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=interview_ai_coach

# NOTE : DATABASE_URL est construite automatiquement par docker-compose à partir
# des variables ci-dessus, avec le host "db" (nom du service). Ne la définir ici
# que si vous voulez pointer vers une base externe.

# --- Application ------------------------------------------------------------
PROJECT_NAME="InterviewAI Coach API"
API_V1_STR="/api/v1"
SECRET_KEY=change_me_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880
# --- Réponses vocales (transcription via Gemini) ----------------------------
AUDIO_UPLOAD_DIR=uploads/audio
MAX_AUDIO_SIZE=10485760
GEMINI_TRANSCRIPTION_MODEL=gemini-2.0-flash
TRANSCRIPTION_TIMEOUT_SECONDS=120

# --- Clés API IA (un seul provider suffit ; priorité GROQ > GEMINI > OPENAI) --
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
OPENAI_API_KEY=
