# Application Settings
PROJECT_NAME="InterviewAI Coach API"
API_V1_STR="/api/v1"
SECRET_KEY="change_me_generate_a_random_secret_key"

# API Keys (renseigner au moins une clé dans le vrai fichier .env, JAMAIS ici)
# Priorité: GROQ > GEMINI > OPENAI
GROQ_API_KEY=""
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interview_ai_coach
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_ai_coach
